    {"id":"environment.cover.seek.full-or-partial","classification":"mechanic","status":"Extracted","source":{"printedPage":58,"section":"Cover"},"summary":"In terrain that can provide cover, a combatant can spend a fast action to seek full or partial cover.","trigger":["combatant seeks cover"],"inputs":["terrain cover availability","selected cover level"],"outcome":{"type":"state-change","value":"enter full or partial cover"},"exceptions":["Full cover blocks line of sight and protects the entire body; partial cover exposes head and arms and permits firing across cover."],"dependencies":["combat.action.fast.seek-cover"],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","combat","user input"],"unknowns":[]}},
    {"id":"environment.cover.direction.arc","classification":"mechanic","status":"Extracted","source":{"printedPage":58,"section":"Direction of Cover"},"summary":"Terrain cover protects in one adjacent-hex direction and outward within a 120-degree angle.","trigger":["attack tests terrain cover effectiveness"],"inputs":["cover direction","attacker hex","target hex"],"outcome":{"type":"calculation","value":"cover effective only in printed directional arc"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","user input"],"unknowns":["Directional geometry requires scene support."]}},
    {"id":"environment.cover.barrier.opposite-side","classification":"mechanic","status":"Extracted","source":{"printedPage":58,"section":"Barriers"},"summary":"Cover from a barrier is effective against attackers on the other side of the barrier.","trigger":["attack crosses barrier"],"inputs":["barrier position","attacker side","target side"],"outcome":{"type":"permission","value":"apply barrier cover"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","user input"],"unknowns":[]}},
    {"id":"environment.cover.same-hex.exception","classification":"mechanic","status":"Extracted","source":{"printedPage":58,"section":"Same Hex"},"summary":"Cover does not affect ranged attacks from an enemy in the same hex, except when the combatants are on opposite sides of a barrier crossing that hex.","trigger":["same-hex ranged attack tests cover"],"inputs":["same hex","barrier sides"],"outcome":{"type":"prohibition","value":"do not apply cover"},"exceptions":["Apply cover if opponents are on opposite sides of a barrier crossing the hex."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","user input"],"unknowns":[]}},
    {"id":"environment.cover.mapless.referee","classification":"mechanic","status":"Extracted","source":{"printedPage":59,"section":"No Hexes?"},"summary":"Without a battle map or on a map without hexes, the Referee decides whether cover is effective.","trigger":["cover tested without hex map"],"inputs":["Referee determination"],"outcome":{"type":"permission","value":"Referee determines cover effectiveness"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["user input"],"unknowns":["Referee determination is required."]}},
    {"id":"environment.visibility.weather-darkness.lowest-limit","classification":"mechanic","status":"Extracted","source":{"printedPage":59,"section":"Visibility & Line of Sight"},"summary":"When multiple weather or darkness circumstances apply, use the lowest applicable visibility limit; the Referee can adjust visibility further.","trigger":["multiple visibility limits apply"],"inputs":["weather","darkness","Referee adjustment"],"outcome":{"type":"calculation","value":"lowest applicable visibility limit"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","user input"],"unknowns":["Further adjustment is Referee discretion."]}},
