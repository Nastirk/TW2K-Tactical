  "mechanics":[
    {"id":"environment.terrain.hex-dominant-type","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Hex Features"},"summary":"The dominant terrain on a battle map applies to the whole hex; if uncertain, use terrain under the center dot.","trigger":["terrain type for hex required"],"inputs":["battle-map terrain","hex center dot"],"outcome":{"type":"calculation","value":"select one terrain type for hex"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","user input"],"unknowns":["Dominant terrain can require Referee judgment."]}},
    {"id":"environment.terrain.ranged-modifier-application","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Hex Features"},"summary":"A terrain ranged-attack modifier applies to attacks against a target in that terrain hex.","trigger":["ranged attack targets terrain hex"],"inputs":["target terrain","attacker hex","attack type"],"outcome":{"type":"modifier","value":"use Terrain Types table ranged-attacks value"},"exceptions":["No modifier when shooter and target are in the same hex.","No modifier for heavy-weapon area attacks against the hex itself."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","combat","user input"],"unknowns":["Heavy-weapon area-attack classification requires attack data."]}},
    {"id":"environment.terrain.movement-modifier-application","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Hex Features"},"summary":"A terrain movement value modifies MOBILITY or DRIVING rolls made to move additional hexes during a movement action.","trigger":["combatant rolls for additional movement"],"inputs":["current hex terrain","movement skill roll"],"outcome":{"type":"modifier","value":"use Terrain Types table movement value"},"exceptions":[],"dependencies":["combat.movement.run.extra-hexes"],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","actor","combat"],"unknowns":[]}},
    {"id":"environment.terrain.infiltration-modifier-application","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Hex Features"},"summary":"A terrain infiltration value modifies RECON rolls to stay hidden or set up an ambush; it modifies the individual hiding, not the spotter.","trigger":["combatant attempts to stay hidden or set ambush"],"inputs":["hiding combatant terrain","Recon roll"],"outcome":{"type":"modifier","value":"use Terrain Types table infiltration value"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","actor","user input"],"unknowns":[]}},
    {"id":"environment.terrain.elevation.blocks-line-of-sight","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Elevation"},"summary":"Elevated terrain can block line of sight.","trigger":["line of sight crosses elevated terrain"],"inputs":["attacker elevation","target elevation","intervening hex elevation"],"outcome":{"type":"prohibition","value":"line of sight may be blocked"},"exceptions":["The Line of Sight section specifies the blocking-elevation condition."],"dependencies":["environment.visibility.line-of-sight.blocked-by-higher-hex"],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","user input"],"unknowns":["Elevation data is required."]}},
    {"id":"environment.terrain.blocking.no-ground-entry","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Blocking"},"summary":"A blocking-terrain hex cannot be entered by ground movement.","trigger":["ground movement targets blocking terrain"],"inputs":["destination terrain","movement mode"],"outcome":{"type":"prohibition","value":"ground movement entry unavailable"},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":true,"requiredFoundryData":["scene","token"],"unknowns":[]}},
    {"id":"environment.terrain-table.pavement","classification":"mechanic","status":"Extracted","source":{"printedPage":57,"section":"Terrain Types"},"summary":"Pavement has infinite visibility, no ranged or movement modifier, no cover, and -2 infiltration.","trigger":["terrain lookup for pavement"],"inputs":["terrain type"],"outcome":{"type":"table-lookup","value":{"visibilityHexes":"infinite","rangedAttackModifier":0,"movementModifier":0,"cover":false,"infiltrationModifier":-2}},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":true,"requiredFoundryData":["scene"],"unknowns":[]}},
