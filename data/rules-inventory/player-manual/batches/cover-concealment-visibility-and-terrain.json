    {"id":"environment.visibility.firearm-discharge.darkness-loss","classification":"mechanic","status":"Extracted","source":{"printedPage":59,"section":"Light Sources"},"summary":"Discharging a firearm removes the effects of darkness from the shooter until their next turn.","trigger":["combatant discharges firearm while affected by darkness"],"inputs":["firearm discharge","combatant next turn"],"outcome":{"type":"state-change","value":"remove darkness effects until next turn"},"exceptions":[],"dependencies":["combat.turn.previous-and-next"],"automationNotes":{"automatable":true,"requiredFoundryData":["combat","actor","item"],"unknowns":[]}},
    {"id":"environment.visibility.searchlight","classification":"mechanic","status":"Extracted","source":{"printedPage":59,"section":"Searchlights"},"summary":"A typical searchlight illuminates a directional area to 10 hexes; targets in that area can be seen at any distance except for terrain and weather limits.","trigger":["target is in searchlight illuminated area"],"inputs":["searchlight direction","distance","terrain","weather"],"outcome":{"type":"prohibition","value":"remove darkness effects"},"exceptions":["Terrain and weather still limit visibility."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","item","user input"],"unknowns":["Directional area requires scene geometry."]}},
    {"id":"environment.visibility.illumination-flare","classification":"mechanic","status":"Extracted","source":{"printedPage":59,"section":"Flares"},"summary":"An illumination round from a grenade launcher or mortar lets targets in its illuminated area be seen at any distance except for terrain and weather limits.","trigger":["target is in illumination-round area"],"inputs":["illuminated area","terrain","weather"],"outcome":{"type":"prohibition","value":"remove darkness effects"},"exceptions":["Terrain and weather still limit visibility."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["scene","token","item","user input"],"unknowns":["Illuminated area requires scene data."]}},
