    {"id":"environment.visibility.night-vision-sight.short-range","classification":"mechanic","status":"Extracted","source":{"printedPage":127,"section":"Weapons Gear"},"summary":"A night-vision sight lets a firearm be fired without darkness restrictions or modifiers only within SHORT range.","trigger":["firearm uses night-vision sight in darkness"],"inputs":["night-vision sight","attack range band"],"outcome":{"type":"prohibition","value":"remove darkness restrictions and modifiers within SHORT range"},"exceptions":["Without its infrared light, the sight sees at most two hexes.","The infrared light is visible to other night-vision devices."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["item","combat","scene","user input"],"unknowns":["Infrared-light state requires input."]}},
    {"id":"environment.visibility.night-vision-sight.no-ir-two-hexes","classification":"mechanic","status":"Extracted","source":{"printedPage":127,"section":"Weapons Gear"},"summary":"A night-vision sight used without its infrared light can see no farther than two hexes.","trigger":["night-vision sight infrared light inactive"],"inputs":["night-vision sight","infrared-light state","distance"],"outcome":{"type":"calculation","value":{"maximumVisibility":"2 hexes"}},"exceptions":[],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["item","scene","token","user input"],"unknowns":[]}},
    {"id":"environment.visibility.night-vision-goggles","classification":"mechanic","status":"Extracted","source":{"printedPage":129,"section":"Observation Gear"},"summary":"Night-vision goggles eliminate darkness modifiers to RANGED COMBAT and RECON to one hex, or two hexes when using attached infrared light; they require a battery.","trigger":["user wears powered night-vision goggles"],"inputs":["goggles","battery","attached infrared-light state","distance"],"outcome":{"type":"prohibition","value":"remove darkness modifiers to Ranged Combat and Recon within printed range"},"exceptions":["One hex applies in near-total darkness; attached infrared light permits total darkness and two hexes."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["actor","item","scene","token","user input"],"unknowns":["Near-total versus total darkness and infrared-light state require input."]}},
