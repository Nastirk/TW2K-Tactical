  "status":"Extracted",
  "mechanics":[
    {"id":"combat.initiative.draw-per-participant","classification":"mechanic","status":"Extracted","source":{"printedPage":54,"section":"Drawing Initiative"},"summary":"At combat start, each participating player character draws one initiative card and the Referee draws one for each NPC or NPC group.","trigger":["combat begins"],"inputs":["combat participants","initiative deck"],"outcome":{"type":"calculation","value":"assign one card number to each participant"},"exceptions":["Normal cards can be used after removing face cards and treating aces as ones."],"dependencies":[],"automationNotes":{"automatable":true,"requiredFoundryData":["combat","actor","user input"],"unknowns":[]}},
    {"id":"combat.initiative.lowest-card-first","classification":"mechanic","status":"Extracted","source":{"printedPage":54,"section":"Drawing Initiative"},"summary":"Combatants act from the lowest initiative-card number to the highest; card #1 acts first.","trigger":["initiative cards assigned"],"inputs":["initiative card number"],"outcome":{"type":"calculation","value":"ascending numeric turn order"},"exceptions":[],"dependencies":["combat.initiative.draw-per-participant"],"automationNotes":{"automatable":true,"requiredFoundryData":["combat"],"unknowns":[]}},
    {"id":"combat.initiative.persist-through-conflict","classification":"mechanic","status":"Extracted","source":{"printedPage":54,"section":"Drawing Initiative"},"summary":"Initiative order remains unchanged for the conflict; initiative is drawn only at the first round's start.","trigger":["a round ends"],"inputs":["combat initiative order"],"outcome":{"type":"state-change","value":"retain initiative order for next round"},"exceptions":["Hidden initiative uses a different redraw procedure."],"dependencies":["combat.initiative.hidden.redraw-each-round"],"automationNotes":{"automatable":true,"requiredFoundryData":["combat"],"unknowns":[]}},
    {"id":"combat.initiative.surprise.first-round-card-one","classification":"mechanic","status":"Extracted","source":{"printedPage":54,"section":"Surprise"},"summary":"A combatant initiating combat with an attack the Referee deems fully surprising automatically receives initiative card #1 in the first round.","trigger":["fully surprising initiating attack"],"inputs":["Referee surprise determination"],"outcome":{"type":"state-change","value":{"initiativeCard":1,"duration":"first round"}},"exceptions":["All other combatants, including allies, draw normally."],"dependencies":["combat.initiative.draw-per-participant"],"automationNotes":{"automatable":false,"requiredFoundryData":["combat","user input"],"unknowns":["Whether the attack is fully surprising is a Referee determination."]}},
    {"id":"combat.initiative.exchange.willing-unacted-participant","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"Exchanging Initiative"},"summary":"On their turn and before acting, a combatant can exchange initiative cards with a willing PC or NPC whose turn has not occurred in the current round.","trigger":["combatant declares exchange on own turn before action"],"inputs":["current turn","recipient willingness","recipient turn status","communication capability"],"outcome":{"type":"state-change","value":"swap initiative cards"},"exceptions":["The two combatants must be able to speak, including by radio.","Reactive actions remain spent after the exchange."],"dependencies":[],"automationNotes":{"automatable":false,"requiredFoundryData":["combat","actor","user input"],"unknowns":["Communication capability requires input."]}},
    {"id":"combat.initiative.hidden.redraw-each-round","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"Hidden Initiative"},"summary":"Under the hidden-initiative alternative rule, initiative cards are secret and redrawn at the start of every round.","trigger":["hidden initiative alternative rule enabled","round starts"],"inputs":["hidden-initiative option","initiative deck"],"outcome":{"type":"calculation","value":"draw new secret initiative cards each round"},"exceptions":["During an exchange, the recipient cannot reveal their initiative number before the switch."],"dependencies":["combat.initiative.draw-per-participant"],"automationNotes":{"automatable":true,"requiredFoundryData":["combat","user input"],"unknowns":[]}},
    {"id":"combat.initiative.npc-group.single-card","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"NPC Initiative"},"summary":"The Referee can assign one initiative card to a same-stat NPC group; all group members act at that point and the Referee chooses their individual order.","trigger":["identical-stat NPC group in combat"],"inputs":["NPC group membership","NPC statistics"],"outcome":{"type":"permission","value":"one shared initiative card"},"exceptions":["Large groups can be divided into smaller groups."],"dependencies":["combat.initiative.draw-per-participant"],"automationNotes":{"automatable":false,"requiredFoundryData":["combat","actor","user input"],"unknowns":["Group composition is a Referee choice."]}},
    {"id":"combat.turn.previous-and-next","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"Your Turn"},"summary":"A combatant's next turn is their next normal initiative point, and their previous turn is their latest normal initiative point, whether either lies in the current or an adjacent round.","trigger":["a rule refers to previous turn or next turn"],"inputs":["initiative order","current round","current turn"],"outcome":{"type":"calculation","value":"resolve the combatant's adjacent normal initiative points"},"exceptions":[],"dependencies":["combat.initiative.lowest-card-first"],"automationNotes":{"automatable":true,"requiredFoundryData":["combat"],"unknowns":[]}},
    {"id":"combat.actions.turn.allowance","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"Slow & Fast Actions"},"summary":"On a turn, a combatant can perform one slow and one fast action, or two fast actions.","trigger":["combatant's turn"],"inputs":["actions already spent this round","action speed"],"outcome":{"type":"calculation","value":{"allowed":"one slow plus one fast, or two fast"}},"exceptions":["Free actions do not count toward the two actions."],"dependencies":[],"automationNotes":{"automatable":true,"requiredFoundryData":["combat","actor"],"unknowns":[]}},
    {"id":"combat.actions.free.own-turn-only","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"Slow & Fast Actions"},"summary":"Free actions do not count against the two actions, but are available only on the combatant's own turn.","trigger":["free action declared"],"inputs":["current turn","action type"],"outcome":{"type":"permission","value":"does not spend slow or fast action"},"exceptions":["A failed CUF roll can force a combatant prone outside their turn."],"dependencies":[],"automationNotes":{"automatable":true,"requiredFoundryData":["combat","actor"],"unknowns":[]}},
    {"id":"combat.actions.help.same-speed-cost","classification":"mechanic","status":"Extracted","source":{"printedPage":55,"section":"Helping Others"},"summary":"Helping another combatant costs one action of the same speed as the supported action and must be declared before dice are rolled.","trigger":["combatant declares help"],"inputs":["supported action speed","declaration timing"],"outcome":{"type":"calculation","value":"spend one matching slow or fast action"},"exceptions":["Helping occurs out of turn and breaks initiative order."],"dependencies":["combat.actions.turn.allowance"],"automationNotes":{"automatable":false,"requiredFoundryData":["combat","actor","user input"],"unknowns":["Whether declaration preceded all dice requires roll-history input."]}},
